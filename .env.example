# =========================================================
# SocmedInsight — Environment Variables
# =========================================================

# ---- Session ----
# Wajib. String random 32+ karakter. Generate: openssl rand -hex 32
SESSION_SECRET=generate-dengan-openssl-rand-hex-32

# ---- Vercel Cron ----
# Wajib jika memakai cron di vercel.json. Generate: openssl rand -hex 32
CRON_SECRET=generate-dengan-openssl-rand-hex-32

# ---- Admin bootstrap (dipakai sekali saat db:init) ----
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=ganti-dengan-password-kuat

# =========================================================
# Database — pilih SALAH SATU:
# =========================================================

# --- MODE A: Turso libSQL (Production / Vercel) ---
# Sign up di https://turso.tech, buat database, dapetin URL + token.
# Contoh: libsql://socmed-insight-yourname.turso.io
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=replace-with-turso-auth-token

# --- MODE B: SQLite file lokal (Development / Self-host) ---
# Kalau TURSO_* kosong, otomatis pake file lokal.
# DATABASE_PATH=./data/data.db

# ---- Node env ----
NODE_ENV=production
