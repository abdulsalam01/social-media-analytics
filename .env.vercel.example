# Copy these keys to Vercel Project Settings > Environment Variables.
# Never commit real secret values.
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=replace-with-turso-auth-token
SESSION_SECRET=generate-dengan-openssl-rand-hex-32
CRON_SECRET=generate-dengan-openssl-rand-hex-32
GEMINI_API_KEY=replace-with-google-ai-studio-key
GEMINI_MODEL=gemini-flash-lite-latest
# X_BEARER_TOKEN=optional-x-api-bearer-token
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=ganti-dengan-password-kuat
